{
  "name": "universal-media-downloader",
  "version": "2.4.0",
  "description": "Universal Media Downloader - Native Desktop Creative Utility",
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:electron": "electron-builder",
    "build": "npm run build:ui && npm run build:electron"
  },
  "keywords": [
    "electron",
    "media-downloader",
    "yt-dlp",
    "ffmpeg",
    "aria2"
  ],
  "author": "Universal Media Downloader",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "youtube-dl-exec": "^3.0.12"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
